# For now, we will bind to port 80 (HTTP). 
# If you get a domain name later, you just replace ":80" with "yourdomain.com" 
# and Caddy automatically generates a Let's Encrypt SSL certificate!
:80 {
    # Changed from handle_path to handle!
    handle /api/* {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:80
    }
}